rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 好友排行：rooms/{roomId}/players/{uid}
    // 只有登入（匿名也算）的人能讀；每個人只能寫自己的那一筆，而且只能寫這幾個欄位。
    match /rooms/{roomId}/players/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'sum', 'diff', 'plateMasked', 'palette', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.sum is int && request.resource.data.sum >= 0 && request.resource.data.sum <= 36;
    }
    // 錯峰點燈帳本：每趟行程、每天算過的格子、每月錯峰之光與 Points。
    // 只有 Cloud Functions（recordTrip，用 Admin SDK）能寫；登入的人只能讀自己的。
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // 城市錯峰人數的公開值：不到 20 人為 null、其餘四捨五入到 10，由 Cloud Functions 寫入。
    match /cityPublic/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // 城市錯峰人數的原始值（cityCounts）只給伺服器用，不另外開放，落到下面的全部拒絕。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
