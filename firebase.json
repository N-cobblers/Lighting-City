{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**/*.glb", "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }, { "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "**/*.onnx", "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }, { "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }, { "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
